{
  "name": "weekly-150-web",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "functions:serve": "supabase functions serve",
    "web:build": "node tools/web/build.js",
    "web:build:local": "node tools/web/build.js --local",
    "test": "npm run app:test && node --test \"web/test/*.test.js\" && node tools/gpx/gpx-lib.test.js",
    "test:smoke": "node --test tools/web/smoke.test.js",
    "app:dev": "vite --config app/vite.config.mjs",
    "app:build": "node tools/web/build.js && vite build --config app/vite.config.mjs",
    "app:test": "vitest run --config app/vite.config.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "supabase": "2.122.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  }
}
